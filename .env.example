# Prisma requires this to look like a valid sqlite URL for schema validation,
# but the actual connection is routed through the Turso driver adapter below
# (see prisma.config.ts and lib/db.ts) and this value is otherwise unused.
DATABASE_URL="file:./dev.db"

# Turso (libSQL) — create a free database at https://app.turso.tech and
# generate an auth token from the database's dashboard page.
TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN="your-auth-token"

# Demo admin credentials, used by the seed script to create the initial admin user
# and by the admin login form. Change these for any non-local demo.
ADMIN_EMAIL="admin@veridianlabs.demo"
ADMIN_PASSWORD="ChangeMe!2024"

# Secret used to sign the admin session cookie (HMAC). Generate your own random
# string for anything beyond local development, e.g. `openssl rand -hex 32`.
SESSION_SECRET="replace-with-a-long-random-string"
