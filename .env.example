# Local SQLite database file (used by Prisma). Do not point this at an external DB for this MVP.
DATABASE_URL="file:./dev.db"

# Demo admin credentials, used by the seed script to create the initial admin user
# and by the admin login form. Change these for any non-local demo.
ADMIN_EMAIL="admin@veridianlabs.demo"
ADMIN_PASSWORD="ChangeMe!2024"

# Secret used to sign the admin session cookie (HMAC). Generate your own random
# string for anything beyond local development, e.g. `openssl rand -hex 32`.
SESSION_SECRET="replace-with-a-long-random-string"
