// Prisma schema for the Veridian Labs research-product e-commerce MVP.
// SQLite is used for local/demo persistence only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  archived    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([slug])
}

model Product {
  id               String             @id @default(cuid())
  name             String
  slug             String             @unique
  sku              String             @unique
  price            Int
  compareAtPrice   Int?
  shortDescription String
  description      String
  specifications   String
  stock            Int                @default(0)
  active           Boolean            @default(true)
  featured         Boolean            @default(false)
  categoryId       String
  category         Category           @relation(fields: [categoryId], references: [id])
  images           ProductImage[]
  documents        ProductDocument[]
  orderItems       OrderItem[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([slug])
  @@index([sku])
  @@index([categoryId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String   @default("")
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductDocument {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      String
  title     String
  url       String
  createdAt DateTime @default(now())

  @@index([productId])
}

model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique
  email                 String
  firstName             String
  lastName              String
  address               String
  city                  String
  state                 String
  zip                   String
  country               String
  subtotal              Int
  shipping              Int
  total                 Int
  status                String      @default("pending_payment")
  trackingNumber        String?
  notes                 String?
  ageConfirmed          Boolean     @default(false)
  researchUseConfirmed  Boolean     @default(false)
  termsAccepted         Boolean     @default(false)
  items                 OrderItem[]
  payment               Payment?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([orderNumber])
  @@index([email])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String
  productSku   String
  unitPrice    Int
  quantity     Int
  lineTotal    Int
  createdAt    DateTime @default(now())
}

model Payment {
  id                String    @id @default(cuid())
  orderId           String    @unique
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String    @default("mock_crypto")
  status            String    @default("pending")
  currency          String
  cryptoAmount      String
  walletAddress     String
  providerPaymentId String?   @unique
  expiresAt         DateTime
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([providerPaymentId])
}
